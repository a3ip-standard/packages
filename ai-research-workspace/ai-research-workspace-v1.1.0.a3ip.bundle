  - Claude Code: ~/.claude/packages/ai-research-workspace/
  - Codex: ~/.codex/packages/ai-research-workspace/
  - Cowork: ~/.claude/packages/ai-research-workspace/. IMPORTANT for the install AI: expand the user-typed value to an absolute path before writing to config.json or installed.json. The path-expansion mechanism is host-runtime-specific -- consult adapters/runtime/<your-platform>/install-skill.md for the file-tool that expands `~` correctly on this host. The runtime AI reads the stored value as-is, so storing a literal `~` breaks the runtime config lookup. Strip trailing separators (slash or backslash) before storing."
    type: string
    required: true
    default: "~/.claude/packages/ai-research-workspace/"
    placeholder: "~/.claude/packages/ai-research-workspace/"
    when: before
    preserve_on_uninstall: false

  - key: workspace_dir
    label: "Research workspace directory"
    description: "Absolute path to the directory where your research notes live. The package writes papers/, experiments/, and syntheses/ subdirectories here. Persists across uninstalls -- your research data survives even if you remove the package."
    type: string
    required: true
    placeholder: "C:/Users/you/Research"
    when: before
    preserve_on_uninstall: true

  - key: author_name
    label: "Your name"
    description: "Used for attribution on synthesis documents and review blocks (e.g., 'Reviewed by <author_name> on <date>'). No external services involved."
    type: string
    required: true
    placeholder: "Alex Researcher"
    when: before
    preserve_on_uninstall: "ask"

  - key: default_review_template
    label: "Default review template"
    description: "Which structured review template the `review papers` protocol applies by default. The user can override per session. 'concise' = 5 questions; 'detailed' = 12 questions covering methodology, results, threats to validity; 'critical' = 8 questions emphasizing weaknesses and counter-arguments."
    type: select
    required: true
    default: "detailed"
    when: before
    preserve_on_uninstall: "ask"
    options:
      - value: concise
        label: "Concise (5 questions, fast scan)"
      - value: detailed
        label: "Detailed (12 questions, methodology + results + validity)"
        default: true
      - value: critical
        label: "Critical (8 questions, emphasis on weaknesses)"

  - key: pdf_viewer_hint
    label: "PDF viewer (optional)"
    description: "Local command or path to your preferred PDF reader. Used as a hint in paper files (added to frontmatter as a 'pdf_open_with' field) so the AI can suggest how to open the PDF locally. Leave blank to skip."
    type: string
    required: false
    placeholder: "C:/Program Files/SumatraPDF/SumatraPDF.exe"
    when: before
    preserve_on_uninstall: "ask"


# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - codex
    - claude-code

