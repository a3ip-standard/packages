  protocols:
    - path: components/protocols/add-paper.md
      description: "Capture a paper into the workspace from a URL / DOI / arXiv ID / local PDF reference. Creates a structured markdown file under papers/ with frontmatter (title, authors, year, source, status=queued) and a notes block."
    - path: components/protocols/log-experiment.md
      description: "Record an experiment run: hypothesis, config, result, verdict, observations. Creates a structured markdown file under experiments/ with date-prefixed name and frontmatter."
    - path: components/protocols/link-experiment-to-paper.md
      description: "Cross-link an experiment with a paper that motivated or tested it. Adds bidirectional references in both files' frontmatter (related_papers in the experiment; related_experiments in the paper)."
    - path: components/protocols/review-papers.md
      description: "Walk a list of queued papers and apply the structured review template (concise / detailed / critical). Advances status (queued -> reviewed). The default template comes from config.default_review_template but the user can override per session."
    - path: components/protocols/synthesize-findings.md
      description: "Generate a synthesis document summarizing the user-chosen subset of reviewed papers, plus any linked experiments. The synthesis follows a structured outline (themes, methods, gaps, recommendations). Output goes to syntheses/<date>-<topic>.md."

  prompts: []

  scripts: []

