# ─────────────────────────────────────────
# A3IP Manifest
# Generated by A3IP Creator on 2026-06-22
# ─────────────────────────────────────────

a3ip: "1.10"
min_a3ip_spec: "1.10"
latest_change: 2026-06-22
name: "ai-standup-assistant"
version: "1.0.0"
description: >
  Generates a structured daily standup by aggregating activity across configured GitHub repos. Reports yesterday's commits and merged PRs, today's work in progress (open PRs, in-flight issues), and blockers (PRs awaiting review, issues stalled beyond a threshold). Renders the result to the 'Today's Standup' Cowork artifact card.
author: "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>"
license: "Apache-2.0"

# ─────────────────────────────────────────
# Components
# ─────────────────────────────────────────

components:
  skills:
    - path: components/skills/standup-assistant
      description: "Guides the AI through compiling a daily standup from GitHub activity across configured projects: queries commits/PRs/issues, classifies into yesterday/today/blockers, renders to a Cowork artifact card."

  artifacts:
    - path: components/artifacts/todays-standup
      description: "Three-section card (Yesterday, Today, Blockers) showing the latest compiled standup. Refreshed each time the run-standup protocol runs. Uses inline CSS only (Cowork artifact runtime does not load Tailwind from CDN)."

  protocols:
    - path: components/protocols/run-standup.md
      description: "Aggregates the user's last-24h GitHub activity across configured projects, classifies into yesterday/today/blockers, renders per the user's chosen format, and refreshes the Today's Standup artifact card."

  prompts: []

  scripts: []

# ─────────────────────────────────────────
# External dependencies
# ─────────────────────────────────────────

dependencies:
  mcp:
    - name: github
      required: true
      purpose: "Queries commits, pull requests, and issues across the configured projects. Specifically: list_commits, list_pull_requests, search_issues."
      registry: "https://api.githubcopilot.com/mcp/"
      fallback: "Without GitHub MCP the skill cannot run. Must add the official GitHub MCP server (api.githubcopilot.com/mcp/) via Connectors -- not the built-in 'GitHub Integration' which only handles file attachment."
    - name: cowork
      required: false
      purpose: "Cowork artifact mechanism for the Today's Standup card (mcp__cowork__create_artifact / update_artifact / list_artifacts)."
      fallback: "On non-Cowork runtimes, the artifact degrades to a markdown file fallback (artifact.md) maintained at history_dir or install_dir."

  tools: []

# ─────────────────────────────────────────
# Configuration schema
# Values collected during installation wizard.
# Referenced as {{config.<key>}} in protocols, prompts, and scripts.
# ─────────────────────────────────────────

configuration:
  - key: install_dir
    label: "Installation directory"
    description: "Directory where ai-standup-assistant's config.json, installed.json, and scripts will be stored. Default depends on the target platform:
  - Claude Code: ~/.claude/packages/ai-standup-assistant/
  - Codex: ~/.codex/packages/ai-standup-assistant/
  - Cowork: ~/.claude/packages/ai-standup-assistant/. IMPORTANT for the install AI: expand the user-typed value to an absolute path before writing to config.json or installed.json. The path-expansion mechanism is host-runtime-specific -- consult adapters/runtime/<your-platform>/install-skill.md for the file-tool that expands `~` correctly on this host. The runtime AI reads the stored value as-is, so storing a literal `~` breaks the runtime config lookup. Strip trailing separators (slash or backslash) before storing."
    type: string
    required: true
    default: "~/.claude/packages/ai-standup-assistant/"
    placeholder: "~/.claude/packages/ai-standup-assistant/"
    when: before
    preserve_on_uninstall: false

  - key: projects
    label: "GitHub projects to track"
    description: "List of GitHub repos to aggregate activity across. Each entry has owner and repo. The skill queries each in turn for commits, PRs, and issues authored or assigned to author_login."
    type: list<string>
    required: true
    placeholder: '[{"owner": "acme-corp", "repo": "primary-app"}]'
    when: before
    preserve_on_uninstall: "ask"

  - key: author_login
    label: "Your GitHub login"
    description: "Your GitHub username. Used to filter commits, PRs, and issues to those involving you. Independent of which account authenticated the GitHub MCP server -- the config is the truth source."
    type: string
    required: true
    placeholder: "octocat"
    when: before
    preserve_on_uninstall: "ask"

  - key: standup_format
    label: "Standup output format"
    description: "How the standup is rendered. concise = three short lines, one per section. detailed = markdown subsections with bullets. narrative = ~80-word first-person paragraph suitable for pasting into Slack/Teams."
    type: select
    required: true
    when: before
    preserve_on_uninstall: "ask"
    options:
      - value: concise
        label: "Concise (3-line summary)"
      - value: detailed
        label: "Detailed (full sections with bullets)"
        default: true
      - value: narrative
        label: "Narrative (1-paragraph prose)"

  - key: blocker_window_days
    label: "Blocker detection threshold (days)"
    description: "An item counts as a blocker if it has been open and unresolved for at least this many days. Lower values surface more items as blockers; higher values are more conservative."
    type: number
    required: true
    default: 3
    when: before
    preserve_on_uninstall: "ask"

  - key: history_dir
    label: "Standup history directory (optional)"
    description: "Optional absolute path. If non-empty, each run appends a record to history_dir/standups/YYYY-MM-DD.md for retrospective review. If empty, only the artifact is updated and no filesystem trail is kept."
    type: string
    required: false
    default: ""
    when: before
    preserve_on_uninstall: "ask"


# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - codex
    - claude-code

