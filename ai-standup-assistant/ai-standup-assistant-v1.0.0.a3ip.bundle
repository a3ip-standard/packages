{
  "name": "ai-standup-assistant",
  "version": "1.0.0",
  "description": "Generates a structured daily standup by aggregating activity across configured GitHub repos. Reports yesterday's commits and merged PRs, today's work in progress (open PRs, in-flight issues), and blockers (PRs awaiting review, issues stalled beyond a threshold). Renders the result to the 'Today's Standup' Cowork artifact card.",
  "author": "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>",
  "license": "Apache-2.0",
  "platforms": ["cowork", "codex", "claude-code"],

  "protocols": [
    {
      "name": "run-standup",
      "trigger": "run standup",
      "aliases": ["compile standup", "today's standup", "standup time", "what's my standup"],
      "description": "Aggregates the user's last-24h GitHub activity across configured projects, classifies into yesterday/today/blockers, renders per the user's chosen format, and refreshes the Today's Standup artifact card.",
      "steps": [
        "Load config.json from {{install_dir}}/config.json (path-separator normalize before composing). Validate that projects is non-empty and author_login is set; if missing, tell the user the config is incomplete and stop.",
        "Compute the date window: default last 24 hours. Accept natural-language overrides from the trigger phrase ('for the last 3 days', 'for the last 30 days', 'since Friday') and adjust the window accordingly.",
        "For each project in config.projects: call the GitHub MCP to list_commits authored by config.author_login since window_start; list_pull_requests filtered to PRs the user opened or is requested-reviewer on; search_issues for issues assigned to the user with state:open.",
        "Classify aggregated items into Yesterday (commits + merged/closed PRs + closed issues in window), Today (open PRs user owns + open assigned issues with window activity), Blockers (PRs awaiting user's review for > config.blocker_window_days; issues with no commit/PR activity in window).",
        "Render per config.standup_format: concise (3 short lines), detailed (markdown subsections with bullets, repo name in parens when projects > 1), narrative (~80-word first-person paragraph for Slack-pasting).",
        "Refresh the Today's Standup artifact: call mcp__cowork__list_artifacts to find 'todays-standup'; if present call update_artifact with new HTML; if absent call create_artifact with the artifact.html template, substituting the YESTERDAY / TODAY / BLOCKERS / COMPILED-AT / SOURCES markers.",
        "If config.history_dir is non-empty: append a markdown record to {{history_dir}}/standups/YYYY-MM-DD.md (create the standups/ subdir if needed). Overwrite same-day re-runs. Warn-but-don't-fail on write errors -- the artifact is the primary deliverable.",
        "Confirm to the user. If any project query failed (rate-limited, repo not accessible), name which ones and what was lost. If history was written, name the file path."
      ]
    }
  ],

  "skills": [
    {
      "name": "standup-assistant",
      "description": "Guides the AI through compiling a daily standup from GitHub activity across configured projects: queries commits/PRs/issues, classifies into yesterday/today/blockers, renders to a Cowork artifact card."
    }
  ],

  "artifacts": [
    {
      "name": "todays-standup",
      "description": "Three-section card (Yesterday, Today, Blockers) showing the latest compiled standup. Refreshed each time the run-standup protocol runs. Uses inline CSS only (Cowork artifact runtime does not load Tailwind from CDN)."
    }
  ],

  "prompts": [],
  "scripts": [],

  "configuration": [
    {
      "key": "projects",
      "label": "GitHub projects to track",
      "description": "List of GitHub repos to aggregate activity across. Each entry has owner and repo. The skill queries each in turn for commits, PRs, and issues authored or assigned to author_login.",
      "type": "list<string>",
      "required": true,
      "placeholder": "[{\"owner\": \"acme-corp\", \"repo\": \"primary-app\"}]",
      "when": "before",
      "preserve_on_uninstall": "ask"
    },
    {
      "key": "author_login",
      "label": "Your GitHub login",
      "description": "Your GitHub username. Used to filter commits, PRs, and issues to those involving you. Independent of which account authenticated the GitHub MCP server -- the config is the truth source.",
      "type": "string",
      "required": true,
      "placeholder": "octocat",
      "when": "before",
      "preserve_on_uninstall": "ask"
    },
    {
      "key": "standup_format",
      "label": "Standup output format",
      "description": "How the standup is rendered. concise = three short lines, one per section. detailed = markdown subsections with bullets. narrative = ~80-word first-person paragraph suitable for pasting into Slack/Teams.",
      "type": "select",
      "required": true,
      "when": "before",
      "options": [
        {"value": "concise", "label": "Concise (3-line summary)"},
        {"value": "detailed", "label": "Detailed (full sections with bullets)", "default": true},
        {"value": "narrative", "label": "Narrative (1-paragraph prose)"}
      ],
      "preserve_on_uninstall": "ask"
    },
    {
      "key": "blocker_window_days",
      "label": "Blocker detection threshold (days)",
      "description": "An item counts as a blocker if it has been open and unresolved for at least this many days. Lower values surface more items as blockers; higher values are more conservative.",
      "type": "number",
      "required": true,
      "default": 3,
      "when": "before",
      "preserve_on_uninstall": "ask"
    },
    {
      "key": "history_dir",
      "label": "Standup history directory (optional)",
      "description": "Optional absolute path. If non-empty, each run appends a record to history_dir/standups/YYYY-MM-DD.md for retrospective review. If empty, only the artifact is updated and no filesystem trail is kept.",
      "type": "string",
      "required": false,
      "default": "",
      "when": "before",
      "preserve_on_uninstall": "ask"
    }
  ],

  "dependencies": {
    "mcp": [
      {
        "name": "github",
        "required": true,
        "purpose": "Queries commits, pull requests, and issues across the configured projects. Specifically: list_commits, list_pull_requests, search_issues.",
        "registry": "https://api.githubcopilot.com/mcp/",
        "fallback": "Without GitHub MCP the skill cannot run. Must add the official GitHub MCP server (api.githubcopilot.com/mcp/) via Connectors -- not the built-in 'GitHub Integration' which only handles file attachment."
      },
      {
        "name": "cowork",
        "required": false,
