<style>
  .standup-root { padding: 1.5rem; max-width: 64rem; margin: 0 auto; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; }
  .standup-header { border-bottom: 1px solid var(--border, #e5e7eb); padding-bottom: 0.75rem; margin-bottom: 1.25rem; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .standup-title { font-size: 1.5rem; font-weight: 600; margin: 0; color: var(--text-primary, #111); }
  .standup-subtitle { font-size: 0.875rem; color: var(--text-secondary, #666); margin: 0.25rem 0 0 0; }
  .standup-stamp { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-tertiary, #888); }
  .standup-stamp-label { font-weight: 500; margin-right: 0.5rem; }
  .standup-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .standup-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .standup-section { border: 1px solid var(--border, #e5e7eb); border-radius: 0.5rem; padding: 1rem; background: var(--bg-section, transparent); }
  .standup-section-title { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.75rem 0; }
  .standup-section--yesterday .standup-section-title { color: var(--accent-green, #16a34a); }
  .standup-section--today .standup-section-title { color: var(--accent-blue, #2563eb); }
  .standup-section--blockers .standup-section-title { color: var(--accent-amber, #d97706); }
  .standup-content { font-size: 0.875rem; line-height: 1.5; }
  .standup-content > * + * { margin-top: 0.5rem; }
  .standup-content ul { margin: 0; padding-left: 1.1rem; }
  .standup-content li { margin: 0.25rem 0; }
  .standup-content .empty { color: var(--text-secondary, #666); font-style: italic; }
  .standup-footer { margin-top: 1.5rem; padding-top: 0.75rem; border-top: 1px solid var(--border, #e5e7eb); display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; font-size: 0.75rem; color: var(--text-tertiary, #888); }
  .standup-code { padding: 0.125rem 0.375rem; border-radius: 0.25rem; background: var(--bg-code, rgba(0,0,0,0.06)); font-family: ui-monospace, SFMono-Regular, monospace; }
</style>
<div class="standup-root">
  <header class="standup-header">
    <div>
      <h1 class="standup-title">Today's Standup</h1>
      <p class="standup-subtitle">Compiled by standup-assistant.</p>
    </div>
    <div class="standup-stamp">
