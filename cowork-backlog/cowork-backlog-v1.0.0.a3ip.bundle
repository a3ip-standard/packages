# ─────────────────────────────────────────
# A3IP Manifest
# Generated by A3IP Creator on 2026-06-28
# ─────────────────────────────────────────

a3ip: "1.10"
min_a3ip_spec: "1.10"
latest_change: 2026-06-28
name: "cowork-backlog"
version: "1.0.0"
description: >
  Manage a lightweight project backlog — iterations, stories, tasks, notes, and a read-only Kanban board — across one or more Cowork projects, with all state in human-readable markdown owned by a deterministic engine.
author: "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>"
license: "Apache-2.0"

# ─────────────────────────────────────────
# Components
# ─────────────────────────────────────────

components:
  skills:
    - path: components/skills/cowork-backlog
      description: "Tells the AI how to drive the deterministic backlog engine: the six-entity model (backlog, iteration, story, task, note, reference), the board columns, derived-not-chosen assignees, the move/test discipline, the note-vs-work-vs-CLAUDE.md routing rule, and the multi-project shared-board mechanism."

  artifacts:
    - path: components/artifacts/backlog-board
      description: "A read-only Kanban board that renders each project's stories as cards across the planned → in_progress → test → completed columns, filtered by iteration, with a project switcher for the multi-project shared view. Reads each project's generated board.json by path; never writes state."

  protocols:
    - path: components/protocols/init-backlog.md
      description: "Scaffold a project's .backlog/ folder, create its first iteration, and register it on the shared board."
    - path: components/protocols/track-work.md
      description: "Add stories and tasks, and advance their status across the board columns (planned → in_progress → test → completed)."
    - path: components/protocols/capture-knowledge.md
      description: "Record durable project knowledge as a note (decision, discovery, risk, or gotcha), distinct from actionable work or CLAUDE.md directives."
    - path: components/protocols/open-board.md
      description: "Surface the read-only Kanban board for the tracked project(s)."

  prompts: []

  scripts:
    # Scripts follow a primary-plus-adapters pattern.
    # 'any' platform = Python cross-platform default.
    # 'windows' platform = PowerShell adapter in adapters/windows/scripts/.

    - key: backlog
      description: "Deterministic CLI engine that owns every change to the backlog: id assignment, frontmatter read/write, derived story assignees, status validation, and board generation. Writes the project's .backlog/ markdown files and regenerates board.json + board.html atomically."
      parameters: ["--project", "--hub", "command", "command options"]
      implementations:
        - file: scripts/backlog.py
          platform: any
          trust_level: write-local

# ─────────────────────────────────────────
# Permissions
# ─────────────────────────────────────────

permissions:
  filesystem:
    - path: "{{config.install_dir}}"
      access: read-write
      reason: "Stores the engine script, skill, artifact, and installed.json."
    - path: "<tracked project>/.backlog/"
      access: read-write
      reason: "Backlog state (markdown) plus the generated board.json and board.html for each tracked project."
    - path: "{{config.hub_dir}}"
      access: read-write
      reason: "Shared hub registry (projects.json) and combined board.html for the cross-project view."
  shell:
    - command: python3
      reason: "Runs the backlog engine."
    - command: pip
      reason: "Engine auto-installs PyYAML on first run if it is missing."
  mcp:
    - name: filesystem
      reason: "Optional: the shared board artifact reads each project's board.json by absolute path."

# ─────────────────────────────────────────
# External dependencies
# ─────────────────────────────────────────

dependencies:
  mcp:
    - name: filesystem
      required: false
      purpose: "Lets the shared board artifact read each registered project's board.json by absolute path for the multi-project view."
      registry: "mcp-registry/filesystem"
      fallback: "Without it, use each project's self-contained local board.html instead of the shared cross-project artifact."

  tools:
    - name: python
      version: ">=3.9"
      required: true
      purpose: "Runs the cross-platform backlog engine (auto-installs PyYAML on first run)."

# ─────────────────────────────────────────
# Configuration schema
# Values collected during installation wizard.
# Referenced as {{config.<key>}} in protocols, prompts, and scripts.
# ─────────────────────────────────────────

configuration:
  - key: install_dir
    label: "Installation directory"
    description: "Absolute path where the package stores its engine script, skill, and installed.json."
    type: string
    required: true
    placeholder: 'e.g. C:\Users\you\.claude\packages\cowork-backlog'
    when: before

  - key: hub_dir
    label: "Shared board hub directory"
    description: "Absolute path to the shared hub folder that hosts the cross-project board registry (projects.json) and the combined board.html. Optional — if omitted, each project's board stays self-contained in its own folder. Maps to the COWORK_BACKLOG_HUB environment variable."
    type: string
    required: false
    placeholder: 'e.g. C:\Users\you\OneDrive\Claude\Backlog Hub'
    when: before


# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - claude-code

