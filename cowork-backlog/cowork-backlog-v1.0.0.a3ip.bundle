=== FILE: scripts/backlog.py ===
#!/usr/bin/env python3
"""
cowork-backlog — deterministic CLI engine for the Cowork Backlog system.

Source of truth = human-readable markdown files with YAML frontmatter inside
each project's `.backlog/` folder. A generated `board.json` index plus a hub
snapshot + self-contained `board.html` are regenerated on every change.

See the skill's SKILL.md for the model and the rules Claude must follow.
This script owns the invariants: id assignment, frontmatter read/write,
derived story assignees, status validation, and board generation.

Registry safety (v2): the shared `projects.json` is **derived** by scanning the
per-project snapshots under `<hub>/boards/`. Each project only ever writes its
own `boards/<id>.json`, so there is no read-merge-write of a shared mutable file
— a stale read on a cloud-synced hub (OneDrive/Dropbox) can no longer silently
drop another project. Writes are atomic (temp + os.replace) and reads retry.
"""

import argparse
import datetime
import glob
import json
import os
import re
import subprocess
import sys
import time


# --------------------------------------------------------------------------
# Dependencies
# --------------------------------------------------------------------------
def _ensure_yaml():
    try:
        import yaml  # noqa
        return yaml
    except ImportError:
        sys.stderr.write("[cowork-backlog] installing PyYAML ...\n")
        subprocess.run(
            [sys.executable, "-m", "pip", "install", "--quiet",
             "--break-system-packages", "pyyaml"],
            check=False,
        )
        import yaml  # noqa
        return yaml


yaml = _ensure_yaml()

ASSIGNEES = ["ai", "human", "third_party", "unassigned"]
STATUSES = ["planned", "in_progress", "test", "completed"]
ITER_STATUSES = ["planned", "active", "completed"]
PRIORITIES = ["low", "medium", "high", "critical"]


# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------
def today():
    return datetime.date.today().isoformat()


def now_iso():
    return datetime.datetime.now().isoformat(timespec="seconds")


def slugify(text, maxlen=40):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:maxlen].strip("-") or "item"


def backlog_dir(project):
    return os.path.join(project, ".backlog")


def read_md(path):
    """Return (meta_dict, body_str) for a frontmatter markdown file."""
    with open(path, "r", encoding="utf-8") as f:
        raw = f.read()
    if raw.startswith("---"):
        parts = raw.split("---", 2)
        if len(parts) >= 3:
            meta = yaml.safe_load(parts[1]) or {}
            return meta, parts[2].lstrip("\n")
    return {}, raw


def write_md(path, meta, body=""):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fm = yaml.safe_dump(meta, sort_keys=False, default_flow_style=False,
                        allow_unicode=True).strip()
    with open(path, "w", encoding="utf-8") as f:
        f.write("---\n" + fm + "\n---\n\n" + (body or "").lstrip("\n"))


def _atomic_write_json(path, obj):
    """Write JSON to a temp file then os.replace — readers never see a half file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _read_json_retry(path, attempts=4, delay=0.15):
    """Tolerate cloud-sync lag / half-written files: retry a few times, then give up."""
    if not os.path.exists(path):
        return None
    for i in range(attempts):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            if i == attempts - 1:
                return None
            time.sleep(delay)
    return None


def load_manifest(project):
    p = os.path.join(backlog_dir(project), "backlog.yaml")
    if not os.path.exists(p):
        die("No backlog found at %s — run `init` first." % backlog_dir(project))
    with open(p, "r", encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def save_manifest(project, manifest):
    p = os.path.join(backlog_dir(project), "backlog.yaml")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        yaml.safe_dump(manifest, f, sort_keys=False, default_flow_style=False,
                       allow_unicode=True)


def die(msg, code=1):
    sys.stderr.write("error: " + msg + "\n")
    sys.exit(code)


def ok(msg):
    print(msg)


# --------------------------------------------------------------------------
# Lookups
# --------------------------------------------------------------------------
def story_path(project, sid):
    matches = glob.glob(os.path.join(backlog_dir(project), "stories", sid + "-*.md"))
    matches += glob.glob(os.path.join(backlog_dir(project), "stories", sid + ".md"))
    return matches[0] if matches else None


def all_story_paths(project):
    return sorted(glob.glob(os.path.join(backlog_dir(project), "stories", "*.md")))


def all_iteration_paths(project):
    return sorted(glob.glob(os.path.join(backlog_dir(project), "iterations", "*.md")))


def derive_assignees(tasks):
    """Story marks = distinct set of task assignees, in canonical order.
    No tasks => ['unassigned']."""
    if not tasks:
        return ["unassigned"]
    present = {t.get("assignee", "unassigned") for t in tasks}
    out = [a for a in ASSIGNEES if a in present]
    return out or ["unassigned"]


# --------------------------------------------------------------------------
# Hub resolution
# --------------------------------------------------------------------------
def resolve_hub(args, project, manifest=None):
    if getattr(args, "hub", None):
        return os.path.abspath(args.hub)
    env = os.environ.get("COWORK_BACKLOG_HUB")
    if env:
        return os.path.abspath(env)
    if manifest and manifest.get("hub"):
        return os.path.abspath(manifest["hub"])
    # default: the project folder itself acts as the hub
    return os.path.abspath(project)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
def cmd_init(args):
    project = os.path.abspath(args.project)
    bdir = backlog_dir(project)
    if os.path.exists(os.path.join(bdir, "backlog.yaml")) and not args.force:
        die("backlog already exists at %s (use --force to overwrite manifest)" % bdir)
    for sub in ("iterations", "stories", "notes"):
        os.makedirs(os.path.join(bdir, sub), exist_ok=True)
    pid = args.id or slugify(args.name)
    hub = resolve_hub(args, project)
    manifest = {
        "id": pid,
        "name": args.name,
        "description": args.description or "",
        "current_iteration": None,
        "statuses": STATUSES,
        "assignee_types": ASSIGNEES,
        "priorities": PRIORITIES,
        "hub": hub,
        "created": today(),
        "counters": {"story": 0},
    }
    save_manifest(project, manifest)
    sync(project, hub)
    # store board_path RELATIVE to the hub (with '/'), so it resolves the same regardless
    # of whether it's read from a Windows path or a Linux mount.
    board_path = os.path.relpath(os.path.join(bdir, "board.json"), hub).replace(os.sep, "/")
    upsert_registry(hub, {"id": pid, "name": args.name, "board_path": board_path})
    ok("Initialised backlog '%s' (id: %s)" % (args.name, pid))
    ok("  project : %s" % bdir)
    ok("  hub     : %s" % hub)
    ok("Registered into hub registry %s and generated board.html." % os.path.join(hub, "projects.json"))


def cmd_add_iteration(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    orders = []
    for p in all_iteration_paths(project):
        m, _ = read_md(p)
        orders.append(m.get("order", 0))
    order = (max(orders) + 1) if orders else 1
    iid = "it-%02d" % order
    meta = {
        "id": iid,
        "order": order,
        "name": args.name,
        "status": args.status or "planned",
        "goal": args.goal or "",
        "entry_criteria": args.entry or "",
        "exit_criteria": args.exit or "",
        "created": today(),
    }
    path = os.path.join(backlog_dir(project), "iterations",
                        "%02d-%s.md" % (order, slugify(args.name)))
    write_md(path, meta, "## Goal\n%s\n" % (args.goal or "(define the goal)"))
    if not manifest.get("current_iteration"):
        manifest["current_iteration"] = iid
        save_manifest(project, manifest)
    sync(project, resolve_hub(args, project, manifest))
    ok("Added iteration %s — %s" % (iid, args.name))


def cmd_add_story(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    iteration = args.iteration or manifest.get("current_iteration")
    if not iteration:
        die("no iteration given and no current_iteration set")
    n = manifest.get("counters", {}).get("story", 0) + 1
    manifest.setdefault("counters", {})["story"] = n
    sid = "S-%03d" % n
    meta = {
        "id": sid,
        "title": args.title,
        "iteration": iteration,
        "status": args.status or "planned",
        "priority": args.priority or "medium",
        "blocked": False,
        "assignees": ["unassigned"],
        "references": list(args.ref or []),
        "tasks": [],
        "created": today(),
        "updated": today(),
    }
    body = "## Description\n%s\n\n## Acceptance criteria\n%s\n" % (
        args.description or "(describe the value this story delivers)",
        "\n".join("- " + a for a in (args.ac or [])) or "- (define acceptance criteria)",
    )
    path = os.path.join(backlog_dir(project), "stories",
                        "%s-%s.md" % (sid, slugify(args.title)))
    write_md(path, meta, body)
    save_manifest(project, manifest)
    sync(project, resolve_hub(args, project, manifest))
    ok("Added story %s — %s  (iteration %s)" % (sid, args.title, iteration))


def cmd_add_task(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    sp = story_path(project, args.story)
    if not sp:
        die("story %s not found" % args.story)
    if args.assignee not in ASSIGNEES:
        die("assignee must be one of %s" % ", ".join(ASSIGNEES))
    meta, body = read_md(sp)
    tasks = meta.get("tasks") or []
    tnum = (max([int(str(t["id"]).split("-")[-1]) for t in tasks]) + 1) if tasks else 1
    tid = "T-%d" % tnum
    tasks.append({
        "id": tid,
        "title": args.title,
        "status": args.status or "planned",
        "assignee": args.assignee,
    })
    meta["tasks"] = tasks
    meta["assignees"] = derive_assignees(tasks)
    meta["updated"] = today()
    write_md(sp, meta, body)
    sync(project, resolve_hub(args, project, manifest))
    ok("Added task %s to %s (%s) — %s" % (tid, args.story, args.assignee, args.title))
    ok("  %s assignees now: %s" % (args.story, ", ".join(meta["assignees"])))


def _status_warn(current, target, kind):
    order = STATUSES
    if current in order and target in order:
        ci, ti = order.index(current), order.index(target)
        if ti > ci + 1:
            sys.stderr.write(
                "warning: %s jumps %s -> %s, skipping %s. Proceeding.\n"
                % (kind, current, target, ", ".join(order[ci + 1:ti]))
            )


def cmd_move(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    target = args.status
    if "/" in args.id:  # task move:  S-001/T-2
        sid, tid = args.id.split("/", 1)
        sp = story_path(project, sid)
        if not sp:
            die("story %s not found" % sid)
        if target not in STATUSES:
            die("status must be one of %s" % ", ".join(STATUSES))
        meta, body = read_md(sp)
        found = False
        for t in meta.get("tasks", []):
            if t["id"] == tid:
                _status_warn(t.get("status", "planned"), target, "task")
                t["status"] = target
                found = True
        if not found:
            die("task %s not found in %s" % (tid, sid))
        meta["updated"] = today()
        write_md(sp, meta, body)
        ok("Moved %s -> %s" % (args.id, target))
    else:  # story move
        sp = story_path(project, args.id)
        if not sp:
            die("story %s not found" % args.id)
        if target not in STATUSES:
            die("status must be one of %s" % ", ".join(STATUSES))
        meta, body = read_md(sp)
        _status_warn(meta.get("status", "planned"), target, "story")
        meta["status"] = target
        meta["updated"] = today()
        write_md(sp, meta, body)
        ok("Moved %s -> %s" % (args.id, target))
    sync(project, resolve_hub(args, project, manifest))


def cmd_block(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    sp = story_path(project, args.id)
    if not sp:
        die("story %s not found" % args.id)
    meta, body = read_md(sp)
    meta["blocked"] = (args.state == "on")
    meta["updated"] = today()
    write_md(sp, meta, body)
    sync(project, resolve_hub(args, project, manifest))
    ok("%s blocked = %s" % (args.id, meta["blocked"]))


def cmd_note(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    d = today()
    existing = glob.glob(os.path.join(backlog_dir(project), "notes", "N-%s-*.md" % d))
    nnum = len(existing) + 1
    nid = "N-%s-%02d" % (d, nnum)
    meta = {
        "id": nid,
        "type": args.type,
        "attaches_to": args.attaches or "project",
        "date": d,
    }
    path = os.path.join(backlog_dir(project), "notes", nid + ".md")
    write_md(path, meta, args.text.strip() + "\n")
    ok("Noted as %s (%s, attaches to %s): %s"
       % (nid, args.type, meta["attaches_to"], args.text.strip()))


def cmd_link(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    sp = story_path(project, args.id)
    if not sp:
        die("story %s not found" % args.id)
    meta, body = read_md(sp)
    refs = meta.get("references") or []
    if args.ref not in refs:
        refs.append(args.ref)
    meta["references"] = refs
    meta["updated"] = today()
    write_md(sp, meta, body)
    sync(project, resolve_hub(args, project, manifest))
    ok("Linked %s to %s" % (args.id, args.ref))


def cmd_set_current(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    manifest["current_iteration"] = args.iteration
    save_manifest(project, manifest)
    sync(project, resolve_hub(args, project, manifest))
    ok("current_iteration = %s" % args.iteration)


def cmd_status(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    data = build_index(project, manifest)
    it = args.iteration or manifest.get("current_iteration")
    print("# %s" % manifest.get("name"))
    print("iteration: %s\n" % it)
    cols = {s: [] for s in STATUSES}
    for st in data["stories"]:
        if it and st["iteration"] != it:
            continue
        cols[st["status"]].append(st)
    for s in STATUSES:
        print("## %s (%d)" % (s.replace("_", " ").title(), len(cols[s])))
        for st in cols[s]:
            done = sum(1 for t in st["tasks"] if t["status"] == "completed")
            flag = " [BLOCKED]" if st["blocked"] else ""
            print("  %s  %s  <%s>  %d/%d%s"
                  % (st["id"], st["title"], "+".join(st["assignees"]),
                     done, len(st["tasks"]), flag))
        print()


def cmd_sync(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    sync(project, resolve_hub(args, project, manifest))
    ok("Synced board.json and board.html.")


def cmd_register(args):
    project = os.path.abspath(args.project)
    manifest = load_manifest(project)
    hub = resolve_hub(args, project, manifest)
    board_path = os.path.relpath(
        os.path.join(backlog_dir(project), "board.json"), hub).replace(os.sep, "/")
    upsert_registry(hub, {"id": manifest.get("id"), "name": manifest.get("name"),
                          "board_path": board_path})
    ok("Registered '%s' into the shared board registry: %s"
       % (manifest.get("name"), os.path.join(hub, "projects.json")))
    ok("  board_path (relative to hub): %s" % board_path)


# --------------------------------------------------------------------------
# Index + board generation
# --------------------------------------------------------------------------
def build_index(project, manifest):
    iterations = []
    for p in all_iteration_paths(project):
        m, _ = read_md(p)
        iterations.append({
            "id": m.get("id"), "order": m.get("order", 0),
            "name": m.get("name"), "status": m.get("status", "planned"),
            "goal": m.get("goal", ""),
        })
    iterations.sort(key=lambda x: x["order"])
    stories = []
    for p in all_story_paths(project):
        m, _ = read_md(p)
        tasks = m.get("tasks") or []
        stories.append({
            "id": m.get("id"), "title": m.get("title"),
            "iteration": m.get("iteration"), "status": m.get("status", "planned"),
            "priority": m.get("priority", "medium"), "blocked": bool(m.get("blocked")),
            "assignees": m.get("assignees") or derive_assignees(tasks),
            "tasks": tasks, "references": m.get("references") or [],
        })
    stories.sort(key=lambda x: x["id"])
    return {
        "project": {"id": manifest.get("id"), "name": manifest.get("name"),
                    "current_iteration": manifest.get("current_iteration")},
        "statuses": manifest.get("statuses", STATUSES),
        "iterations": iterations,
        "stories": stories,
        "generated_at": now_iso(),
    }


def upsert_registry(hub, entry):
    """Add/replace a project's entry (by id) in <hub>/projects.json.

    Called only by `register` / `init` (rare, deliberate) — NOT on every mutation —
    so the read-merge-write of this shared file is low-risk. The registry stores a
    pointer to each project's OWN board.json (`board_path`); nothing is copied into
    the hub, so projects stay self-contained in their own folders and the shared
    board reads each one in place. Atomic write + retrying read for cloud-sync safety.
    """
    os.makedirs(hub, exist_ok=True)
    reg_path = os.path.join(hub, "projects.json")
    reg = _read_json_retry(reg_path) or {"projects": [], "default": None}
    projs = [p for p in reg.get("projects", []) if p.get("id") != entry["id"]]
    projs.append(entry)
    projs.sort(key=lambda x: (x.get("name") or x.get("id") or "").lower())
    reg["projects"] = projs
    if not reg.get("default"):
        reg["default"] = entry["id"]
    _atomic_write_json(reg_path, reg)
    return reg


def sync(project, hub=None):
    """Write the project's own board.json + a local self-contained board.html.

    The shared hub registry is intentionally NOT touched here — only `register`
    (and `init`) update it. This means routine, frequent mutations never read or
    rewrite the shared registry, so they cannot clobber another project's entry
    (the failure mode that cloud-sync lag used to trigger). The cross-project board
    is the Cowork artifact, which reads each project's board.json live by path.
    """
    manifest = load_manifest(project)
    index = build_index(project, manifest)
    _atomic_write_json(os.path.join(backlog_dir(project), "board.json"), index)
    render_local_board(project, manifest, index)


def render_local_board(project, manifest, index):
    """A standalone board.html in the project folder showing THIS project only —
    an offline, double-click fallback. The combined cross-project view is the
    Cowork artifact (which reads every project's board.json by path)."""
    tpl_path = os.path.join(os.path.dirname(__file__), "..", "assets",
                            "board.template.html")
    if not os.path.exists(tpl_path):
        return
    with open(tpl_path, "r", encoding="utf-8") as f:
        tpl = f.read()
    pid = manifest.get("id")
    payload = {
        "registry": {"projects": [{"id": pid, "name": manifest.get("name"),
                                   "current_iteration": manifest.get("current_iteration")}],
                     "default": pid},
        "boards": {pid: index},
    }
    html = tpl.replace("/*__BACKLOG_DATA__*/null",
                       json.dumps(payload, ensure_ascii=False))
    tmp = os.path.join(project, "board.html.tmp.%d" % os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(html)
    os.replace(tmp, os.path.join(project, "board.html"))


# --------------------------------------------------------------------------
# Arg parsing
# --------------------------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(prog="backlog", description="Cowork Backlog engine")
    p.add_argument("--project", default=".", help="project folder (default: cwd)")
    p.add_argument("--hub", help="hub folder (default: env COWORK_BACKLOG_HUB / manifest / project)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", help="scaffold a backlog and register it in the hub")
    s.add_argument("--name", required=True)
    s.add_argument("--id")
    s.add_argument("--description")
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("add-iteration")
    s.add_argument("--name", required=True)
    s.add_argument("--goal")
    s.add_argument("--entry")
    s.add_argument("--exit")
    s.add_argument("--status", choices=ITER_STATUSES)
    s.set_defaults(func=cmd_add_iteration)

    s = sub.add_parser("add-story")
    s.add_argument("--iteration")
    s.add_argument("--title", required=True)
    s.add_argument("--priority", choices=PRIORITIES)
    s.add_argument("--status", choices=STATUSES)
    s.add_argument("--description")
    s.add_argument("--ac", action="append", help="acceptance criterion (repeatable)")
    s.add_argument("--ref", action="append", help="reference (repeatable)")
    s.set_defaults(func=cmd_add_story)

    s = sub.add_parser("add-task")
    s.add_argument("--story", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--assignee", required=True, choices=ASSIGNEES)
    s.add_argument("--status", choices=STATUSES)
    s.set_defaults(func=cmd_add_task)

    s = sub.add_parser("move", help="change a story or task status (id or id/T-n)")
    s.add_argument("--id", required=True)
    s.add_argument("--status", required=True)
    s.set_defaults(func=cmd_move)

    s = sub.add_parser("block")
    s.add_argument("--id", required=True)
    s.add_argument("--state", choices=["on", "off"], required=True)
    s.set_defaults(func=cmd_block)

    s = sub.add_parser("note", help="record project knowledge (NOT work, NOT a CLAUDE.md rule)")
    s.add_argument("--type", choices=["decision", "discovery", "risk", "gotcha"], required=True)
    s.add_argument("--attaches", help="iteration/story/task id, or 'project'")
    s.add_argument("--text", required=True)
    s.set_defaults(func=cmd_note)

    s = sub.add_parser("link")
    s.add_argument("--id", required=True)
    s.add_argument("--ref", required=True)
    s.set_defaults(func=cmd_link)

    s = sub.add_parser("set-current-iteration")
    s.add_argument("--iteration", required=True)
    s.set_defaults(func=cmd_set_current)

    s = sub.add_parser("status", help="print a text board")
    s.add_argument("--iteration")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("sync", help="regenerate this project's board.json and board.html")
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("register", help="add/update this project in the hub's shared board registry")
    s.set_defaults(func=cmd_register)

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()

=== END FILE ===
