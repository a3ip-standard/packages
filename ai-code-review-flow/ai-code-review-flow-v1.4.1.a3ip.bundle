a3ip: "1.6"
min_a3ip_spec: "1.10"
latest_change: 2026-06-06
name: "ai-code-review-flow"
version: "1.4.1"
description: >
  Generic GitLab/GitHub code review workflow. The AI reads a merge/pull request diff, applies a structured review checklist, and posts the review comment via REST API. Platform and project are chosen at install time.
author: "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>"
license: "Apache-2.0"

# ─────────────────────────────────────────
# Components
# ─────────────────────────────────────────

components:
  skills:
    - path: components/skills/code-review
      description: "Guides the AI through reading an MR/PR diff and producing a structured, actionable code review comment. Defines the 7-category checklist (correctness, security, performance, code quality, tests, breaking changes, documentation), verdict criteria (Approved/Needs Changes/Commented), and output format."

  artifacts:
    - path: components/artifacts/last-review
      description: "Card showing the most recent code review: MR/PR number, verdict (Approved / Needs Changes / Commented), reviewer notes summary, timestamp, and link."

  protocols:
    - path: components/protocols/start-review.md
      description: "Reads the current MR/PR diff, applies the review checklist, posts the structured review comment to GitLab or GitHub, and updates the Last Review artifact."

  prompts: []

  scripts:
    # Scripts follow a primary-plus-adapters pattern.
    # 'any' platform = Python cross-platform default.
    # 'windows' platform = PowerShell adapter in adapters/windows/scripts/.

    - key: post_review
      description: "POST a structured review comment to a GitLab MR or GitHub PR via REST API."
      parameters: ["config_json_path", "mr_number", "review_body", "verdict"]
      implementations:
        - file: scripts/post_review.py
          platform: any
          trust_level: network

# ─────────────────────────────────────────
# External dependencies
# ─────────────────────────────────────────

dependencies:
  mcp: []

  tools:
    - name: python
      version: ">=3.9"
      required: true
      purpose: "Runs post_review.py to call the GitLab or GitHub API."

# ─────────────────────────────────────────
# Permissions (v1.2)
# Declared for the AI installer to show the user before starting.
# ─────────────────────────────────────────

permissions:
  network:
    - domain: "gitlab.com"
      reason: "Posts review comments to GitLab MRs via REST API."
    - domain: "api.github.com"
      reason: "Posts review comments to GitHub PRs via REST API."
  shell:
    - command: python3
      reason: "Runs post_review.py."

# ─────────────────────────────────────────
# Configuration schema
# Values collected during installation wizard.
# Referenced as {{config.<key>}} in protocols, prompts, and scripts.
# ─────────────────────────────────────────

configuration:
  - key: install_dir
    label: "Installation directory"
    description: "Directory where ai-code-review-flow's config.json, installed.json, and scripts will be stored. Default is the platform convention (Cowork / Claude Code: ~/.claude/packages/<name>/, Codex: ~/.codex/packages/<name>/). IMPORTANT for the install AI: expand the user-typed value to an absolute path before writing to config.json or installed.json. On Cowork (Windows), expand `~` to the Windows user home using the platform's native separator -- e.g. ~/.claude/packages/X/ becomes the absolute path under C:/Users/USERNAME/.claude/packages/X/. On Linux/macOS, expand to /home/USERNAME/ or /Users/USERNAME/. The runtime AI reads this value via the Read tool which does NOT expand ~ -- storing a tilde here breaks the runtime config lookup."
    type: string
    required: true
    default: "~/.claude/packages/ai-code-review-flow/"
    placeholder: "~/.claude/packages/ai-code-review-flow/"
    when: before
    preserve_on_uninstall: false       # path is meaningless after uninstall -- purge silently

  - key: platform
    label: "Code hosting platform"
    description: "The platform where your code is hosted."
    type: select
    required: true
    when: before
    options:
      - value: gitlab
        label: "GitLab (gitlab.com or self-hosted)"
        default: true
      - value: github
        label: "GitHub (github.com)"
    preserve_on_uninstall: "ask"       # user may switch platforms on re-install

  - key: project_ref
    label: "Project reference"
    description: "GitLab: numeric project ID (Settings -> General). GitHub: owner/repo slug."
    type: string
    required: true
    placeholder: "12345678  (GitLab)  or  acme/my-service  (GitHub)"
    when: before
    preserve_on_uninstall: "ask"       # depends on user -- could be same or different on re-install

  - key: api_token
    label: "API token"
    description: "Personal access token. GitLab: api scope. GitHub: repo scope."
    type: string
    required: true
    sensitive: true          # installer must not log or display this value
    storage: env-var
    when: before
    preserve_on_uninstall: true        # PAT is hard to re-issue -- preserve silently

  - key: base_url
    label: "GitLab base URL"
    description: "Base URL for self-hosted GitLab. Leave blank to use gitlab.com."
    type: string
    required: false
    default: "https://gitlab.com"
    placeholder: "https://gitlab.mycompany.com"
    when: before
    condition: "platform == gitlab"
    preserve_on_uninstall: "ask"       # self-hosted GitLab URL is org-stable -- ask


# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - claude-code
    - codex
    - cursor

