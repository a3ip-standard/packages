=== FILE: components/artifacts/last-review/artifact.html ===
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Last Code Review</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: transparent; color: #1a1a2e; padding: 16px;
    }
    .card {
      border: 1px solid #e5e7eb; border-radius: 12px;
      padding: 20px 24px 18px; max-width: 460px;
      background: #ffffff; box-shadow: 0 1px 6px rgba(0,0,0,0.06);
    }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .card-label  { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9ca3af; }
    .badge       { font-size: 0.72rem; font-weight: 600; padding: 3px 11px; border-radius: 20px; white-space: nowrap; }
    .badge-approved  { background: #dcfce7; color: #166534; }
    .badge-needs     { background: #fee2e2; color: #991b1b; }
    .badge-commented { background: #fef9c3; color: #854d0e; }
    .badge-empty     { background: #f3f4f6; color: #9ca3af; }
    .mr-ref  { font-size: 1.6rem; font-weight: 700; line-height: 1.1; margin-bottom: 8px; }
    .mr-ref a { color: #4f46e5; text-decoration: none; }
    .mr-ref a:hover { text-decoration: underline; }
    .notes { font-size: 0.84rem; color: #6b7280; line-height: 1.5; margin-bottom: 10px; }
    .ts    { font-size: 0.72rem; color: #d1d5db; }
    .empty-state { text-align: center; padding: 28px 0 20px; color: #d1d5db; font-size: 0.9rem; }
    .empty-icon  { font-size: 2rem; margin-bottom: 8px; display: block; }
  </style>
</head>
<body>
  <div class="card">
    <div class="card-header">
      <span class="card-label">Last Code Review</span>
      <span class="badge badge-empty" id="verdict-badge">--</span>
    </div>
    <div id="empty-state" class="empty-state">
      <span class="empty-icon">&#x1F4CB;</span>
      No review posted yet.
    </div>
    <div id="review-data" style="display:none">
      <div class="mr-ref" id="mr-ref">--</div>
      <div class="notes"  id="notes-display"></div>
      <div class="ts"     id="ts-display"></div>
    </div>
  </div>
  <script>
    /* LAST_REVIEW: the AI replaces this line via mcp__cowork__update_artifact after each review. */
    /* DATA_START */var LAST_REVIEW = null;/* DATA_END */

    function badgeClass(v) {
      if (!v) return "badge-empty";
      v = v.toLowerCase();
      if (v === "approved") return "badge-approved";
      if (v.indexOf("needs") !== -1 || v.indexOf("changes") !== -1) return "badge-needs";
      if (v === "commented") return "badge-commented";
      return "badge-empty";
    }
    function render(data) {
      var badge   = document.getElementById("verdict-badge");
      var empty   = document.getElementById("empty-state");
      var dataDiv = document.getElementById("review-data");
      var mrRef   = document.getElementById("mr-ref");
      var notesEl = document.getElementById("notes-display");
      var tsEl    = document.getElementById("ts-display");
      if (!data || !data.mr) {
        empty.style.display = ""; dataDiv.style.display = "none";
        badge.textContent = "--"; badge.className = "badge badge-empty";
        return;
      }
      empty.style.display = "none"; dataDiv.style.display = "";
      badge.textContent = data.verdict || "--";
      badge.className   = "badge " + badgeClass(data.verdict);
      var label = String(data.mr).match(/^https?:\/\//)
        ? "#" + String(data.mr).split("/").pop() : "#" + data.mr;
      mrRef.innerHTML = data.link
        ? "<a href=\"" + data.link + "\" target=\"_blank\">" + label + "</a>" : label;
      notesEl.textContent = data.notes || "";
      tsEl.textContent = data.ts ? "Reviewed " + new Date(data.ts).toLocaleString() : "";
    }
    render(LAST_REVIEW);
  </script>
</body>
</html>

