# ─────────────────────────────────────────
# A3IP Manifest
# Generated by A3IP Creator on 2026-05-16
# ─────────────────────────────────────────

a3ip: "1.6"
min_a3ip_spec: "1.8"
latest_change: 2026-05-18
name: "ai-code-review-flow"
version: "1.2.1"
description: >
  Generic GitLab/GitHub code review workflow. The AI reads a merge/pull request diff, applies a structured review checklist, and posts the review comment via REST API. Platform and project are chosen at install time.
author: "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>"
license: "Apache-2.0"

# ─────────────────────────────────────────
# Components
# ─────────────────────────────────────────

components:
  skills:
    - path: components/skills/code-review
      description: "Guides the AI through reading an MR/PR diff and producing a structured, actionable code review comment. Defines the 7-category checklist (correctness, security, performance, code quality, tests, breaking changes, documentation), verdict criteria (Approved/Needs Changes/Commented), and output format."

  artifacts:
    - path: components/artifacts/last-review
      description: "Card showing the most recent code review: MR/PR number, verdict (Approved / Needs Changes / Commented), reviewer notes summary, timestamp, and link."

  protocols:
    - path: components/protocols/start-review.md
      description: "Reads the current MR/PR diff, applies the review checklist, posts the structured review comment to GitLab or GitHub, and updates the Last Review artifact."

  prompts: []

  scripts:
    # Scripts follow a primary-plus-adapters pattern.
    # 'any' platform = Python cross-platform default.
    # 'windows' platform = PowerShell adapter in adapters/windows/scripts/.

    - key: post_review
      description: "POST a structured review comment to a GitLab MR or GitHub PR via REST API."
      parameters: ["config_json_path", "mr_number", "review_body", "verdict"]
      implementations:
        - file: scripts/post_review.py
          platform: any
          trust_level: network

# ─────────────────────────────────────────
# External dependencies
# ─────────────────────────────────────────

dependencies:
  mcp: []

  tools:
    - name: python
      version: ">=3.9"
      required: true
      purpose: "Runs post_review.py to call the GitLab or GitHub API."

# ─────────────────────────────────────────
# Permissions (v1.2)
# Declared for the AI installer to show the user before starting.
# ─────────────────────────────────────────

permissions:
  network:
    - domain: "gitlab.com"
      reason: "Posts review comments to GitLab MRs via REST API."
    - domain: "api.github.com"
      reason: "Posts review comments to GitHub PRs via REST API."
  shell:
    - command: python3
      reason: "Runs post_review.py."

# ─────────────────────────────────────────
# Configuration schema
# Values collected during installation wizard.
# Referenced as {{config.<key>}} in protocols, prompts, and scripts.
# ─────────────────────────────────────────

configuration:
  - key: install_dir
    label: "Installation directory"
    description: "Directory where ai-code-review-flow's config.json, installed.json, and scripts will be stored. Default is the platform convention (Cowork / Claude Code: ~/.claude/packages/<name>/, Codex: ~/.codex/packages/<name>/). IMPORTANT for the install AI: expand the user-typed value to an absolute path before writing to config.json or installed.json. On Cowork (Windows), expand `~` to the Windows user home using the platform's native separator -- e.g. ~/.claude/packages/X/ becomes the absolute path under C:/Users/USERNAME/.claude/packages/X/. On Linux/macOS, expand to /home/USERNAME/ or /Users/USERNAME/. The runtime AI reads this value via the Read tool which does NOT expand ~ -- storing a tilde here breaks the runtime config lookup."
    type: string
    required: true
    default: "~/.claude/packages/ai-code-review-flow/"
    placeholder: "~/.claude/packages/ai-code-review-flow/"
    when: before

  - key: platform
    label: "Code hosting platform"
    description: "The platform where your code is hosted."
    type: select
    required: true
    when: before
    options:
      - value: gitlab
        label: "GitLab (gitlab.com or self-hosted)"
        default: true
      - value: github
        label: "GitHub (github.com)"

  - key: project_ref
    label: "Project reference"
    description: "GitLab: numeric project ID (Settings -> General). GitHub: owner/repo slug."
    type: string
    required: true
    placeholder: "12345678  (GitLab)  or  acme/my-service  (GitHub)"
    when: before

  - key: api_token
    label: "API token"
    description: "Personal access token. GitLab: api scope. GitHub: repo scope."
    type: string
    required: true
    sensitive: true          # installer must not log or display this value
    storage: env-var
    when: before

  - key: base_url
    label: "GitLab base URL"
    description: "Base URL for self-hosted GitLab. Leave blank to use gitlab.com."
    type: string
    required: false
    default: "https://gitlab.com"
    placeholder: "https://gitlab.mycompany.com"
    when: before
    condition: "platform == gitlab"


# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - claude-code
    - codex
    - cursor

=== END FILE ===

=== FILE: README.md ===
# ai-code-review-flow

Generic GitLab/GitHub code review workflow. The AI reads a merge/pull request diff, applies a structured review checklist, and posts the review comment via REST API. Platform and project are chosen at install time.

## Workflows

- **"start code review"** — Reads the current MR/PR diff, applies the review checklist, posts the structured review comment to GitLab or GitHub, and updates the Last Review artifact.

## Installation

This is an A3IP package. To install it, give the `.a3ip.bundle` file to
your AI assistant and ask it to install the package.

The AI will guide you through the configuration wizard and set everything up.

## Platforms

- cowork
- claude-code
- codex
- cursor

## Author

Maksym Prydorozhko <maksym.prydorozhko@gmail.com>

=== END FILE ===

=== FILE: scripts/post_review.py ===
#!/usr/bin/env python3
"""
ai-code-review-flow -- post_review.py
POST a structured review comment to a GitLab MR or GitHub PR via REST API.

For GitLab: posts a MR note (comment) with the verdict prepended.
For GitHub:  posts a PR review with APPROVE / REQUEST_CHANGES / COMMENT event.

Usage:
    python3 post_review.py <config_json_path> <mr_number> <review_body> <verdict>

Arguments:
    config_json_path  Path to the config JSON file written by the install wizard
    mr_number         GitLab MR IID or GitHub PR number (integer)
    review_body       The full review comment text (Markdown)
    verdict           One of: Approved | Needs Changes | Commented

Exit codes:
    0  success -- prints the URL of the posted review
    1  error   -- prints a descriptive message to stderr
"""

import json
import sys
import urllib.error
import urllib.request
from pathlib import Path


def api_post(url, payload, headers):
    """POST JSON payload and return parsed response. Raises RuntimeError on non-2xx."""
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {e.code} from {url}\n{body}") from None


def post_gitlab(config, mr_number, review_body, verdict):
    """Post a review note to a GitLab MR. Returns the note URL."""
    base_url = config.get("base_url", "https://gitlab.com").rstrip("/")
    project_ref = config["project_ref"]
    token = config["api_token"]

    body = f"**Verdict:** {verdict}\n\n{review_body}"

    url = f"{base_url}/api/v4/projects/{project_ref}/merge_requests/{mr_number}/notes"
    headers = {
        "Content-Type": "application/json",
        "PRIVATE-TOKEN": token,
    }
    resp = api_post(url, {"body": body}, headers)
    note_id = resp["id"]
    mr_url = (
        f"{base_url}/projects/{project_ref}/merge_requests/{mr_number}"
        f"#note_{note_id}"
    )
    return mr_url


def post_github(config, pr_number, review_body, verdict):
    """Post a PR review to GitHub. Returns the review HTML URL."""
    project_ref = config["project_ref"]
    token = config["api_token"]

    event_map = {
        "approved":       "APPROVE",
        "needs changes":  "REQUEST_CHANGES",
        "commented":      "COMMENT",
    }
    event = event_map.get(verdict.lower(), "COMMENT")

    url = f"https://api.github.com/repos/{project_ref}/pulls/{pr_number}/reviews"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    resp = api_post(url, {"body": review_body, "event": event}, headers)
    return resp.get("html_url", f"https://github.com/{project_ref}/pull/{pr_number}")


def main():
    if len(sys.argv) != 5:
        print(
            "Usage: python3 post_review.py"
            " <config_json_path> <mr_number> <review_body> <verdict>",
            file=sys.stderr,
        )
        sys.exit(1)

    config_path = Path(sys.argv[1])
    mr_number_raw = sys.argv[2]
    review_body = sys.argv[3]
    verdict = sys.argv[4]

    if not config_path.exists():
        print(f"Error: config file not found: {config_path}", file=sys.stderr)
        sys.exit(1)

    try:
        with open(config_path, encoding="utf-8") as f:
            config = json.load(f)
    except json.JSONDecodeError as e:
        print(f"Error: invalid JSON in config file: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        mr_number = int(mr_number_raw)
    except ValueError:
        print(
            f"Error: mr_number must be an integer, got: {mr_number_raw!r}",
            file=sys.stderr,
        )
        sys.exit(1)

    platform = config.get("platform", "gitlab").lower()

    try:
        if platform == "gitlab":
            link = post_gitlab(config, mr_number, review_body, verdict)
        elif platform == "github":
            link = post_github(config, mr_number, review_body, verdict)
        else:
            print(
                f"Error: unsupported platform: {platform!r}"
                " (expected 'gitlab' or 'github')",
                file=sys.stderr,
            )
            sys.exit(1)
    except RuntimeError as e:
        print(f"Error posting review: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyError as e:
        print(f"Error: missing config key: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"Review posted: {link}")


if __name__ == "__main__":
    main()

=== END FILE ===
