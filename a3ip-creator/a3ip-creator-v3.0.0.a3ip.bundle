=== FILE: manifest.yaml ===
# ─────────────────────────────────────────
# A3IP Manifest
# Generated by A3IP Creator on 2026-05-12
# ─────────────────────────────────────────

a3ip: "1.1"
min_a3ip_spec: "1.10"
latest_change: 2026-06-06
name: "a3ip-creator"
version: "3.0.0"
description: >
  A Cowork skill and supporting Python scripts that guide an AI through authoring a new A3IP package from scratch. Conducts a structured intake conversation, generates the complete package directory, runs completeness validation, and produces the distributable bundle.
author: "Maksym Prydorozhko <maksym.prydorozhko@gmail.com>"
license: "Apache-2.0"

# ─────────────────────────────────────────
# Components
# ─────────────────────────────────────────

components:
  skills:
    - path: components/skills/a3ip-creator
      description: "Guides the AI through authoring a new A3IP package from scratch in seven phases: Read Spec, Detect Platform, Intake, Scaffold, Validate, Build, and Version."

  artifacts: []

  protocols:
    - path: components/protocols/create-package.md
      description: "Guides through creating a new A3IP package from scratch: intake conversation, scaffold, validate, and build."
    - path: components/protocols/cut-version.md
      description: "Cuts a new package version: bumps manifest, prepends changelog entry, validates, and rebundles."

  prompts: []

  scripts: []
    # v2.1.0: the Creator no longer ships its own scaffold / sync / new_version /
    # zip_package scripts. These were promoted to first-class subcommands in
    # `a3ip` CLI v1.5.0 -- the Creator's SKILL.md now invokes:
    #   a3ip scaffold <intake.json> --output-dir <dir>
    #   a3ip sync <package_dir>
    #   a3ip new-version <package_dir> <new_version>
    #   a3ip zip <package_dir>
    # This makes the Creator a thin wrapper around the CLI and removes a
    # ~75 KB duplicate-code footprint from the Creator bundle.

# ─────────────────────────────────────────
# External dependencies
# ─────────────────────────────────────────

dependencies:
  mcp: []

  tools:
    - name: a3ip
      version: ">=1.5.2"
      required: true
      purpose: "Runs scaffold (Phase 3), validate (Phase 4), bundle (Phase 5), sync, new-version, and zip. v1.5.0 declares __spec_version__ 1.10, implements Check 14 (uninstall coverage), extends Checks 11/13 to scan uninstall-skill.md adapters, and promotes the four Creator scripts (scaffold/sync/new-version/zip) to first-class CLI subcommands -- the Creator no longer ships its own copies."
      install: "pip install --upgrade a3ip"
    - name: python
      version: ">=3.9"
      required: true
      purpose: "Runs all Creator scripts (scaffold, validate, bundle, zip, new_version)."
    - name: pyyaml
      version: "any"
      required: false
      purpose: "Improves manifest parsing accuracy in validate.py."
      fallback: "validate.py includes a minimal regex-based YAML parser that handles all required fields without PyYAML."

# ─────────────────────────────────────────
# Configuration schema
# Values collected during installation wizard.
# Referenced as {{config.<key>}} in protocols, prompts, and scripts.
# ─────────────────────────────────────────

configuration:
  - key: install_dir
    label: "Installation directory"
    description: "Directory where a3ip-creator's installed.json and runtime state will be stored. Defaults to the platform convention (~/.claude/packages/a3ip-creator/ on Cowork / Claude Code)."
    type: string
    required: true
    default: "~/.claude/packages/a3ip-creator/"
    placeholder: "~/.claude/packages/a3ip-creator/"
    when: before

  # No configuration required.

# ─────────────────────────────────────────
# Platform compatibility
# ─────────────────────────────────────────

platforms:
  tested:
    - cowork
    - claude-code
    - codex
    - cursor

=== END FILE ===

=== FILE: README.md ===
# a3ip-creator

A Cowork skill and supporting Python scripts that guide an AI through authoring a new A3IP package from scratch. Conducts a structured intake conversation, generates the complete package directory, runs completeness validation, and produces the distributable bundle.

## Workflows

- **"create a package"** — Guides through creating a new A3IP package from scratch: intake conversation, scaffold, validate, and build.
- **"cut a new version"** — Cuts a new package version: bumps manifest, prepends changelog entry, validates, and rebundles.

## Installation

This is an A3IP package. To install it, give the `.a3ip.bundle` file to
your AI assistant and say: "Install this package."

The AI will read the instructions and set everything up in your skills directory.
No configuration wizard needed — just Python 3.9+ on your machine.

## Platforms

- cowork
- claude-code
- codex
- cursor

## Author

Maksym Prydorozhko <maksym.prydorozhko@gmail.com>

=== END FILE ===

=== FILE: scripts/requirements.txt ===
# A3IP Creator — script dependencies
#
# Install with:
#   pip install -r requirements.txt
#
# PyYAML is used by validate.py for full manifest parsing.
# Without it, validate.py falls back to a minimal regex-based parser
# that covers all required checks but may miss edge cases in
# non-standard YAML formatting.

PyYAML>=6.0

